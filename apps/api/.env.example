# SkillMango API environment variables
# Copy to apps/api/.env for local development.
# Public API base URL is `${APP_URL}/api/v1`, for example: http://localhost:4000/api/v1.
# Production must override every "change-me" secret and every provider key used by enabled features.

# Database and Redis
# Local Docker defaults match docker/docker-compose.yml.
DATABASE_URL="postgresql://skillmango:skillmango@localhost:5432/skillmango?schema=public"
REDIS_HOST="localhost"
REDIS_PORT=6379

# Auth and JWT
# Use long random secrets in production. AUTH_TOKEN_PEPPER should be separate from JWT secrets.
JWT_ACCESS_SECRET="change-me-in-production-access-secret"
JWT_REFRESH_SECRET="change-me-in-production-refresh-secret"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
AUTH_TOKEN_PEPPER="change-me-in-production-token-pepper"
REQUIRE_EMAIL_VERIFICATION="false"

# Supabase Auth
# Browser login uses NEXT_PUBLIC_SUPABASE_* in the web app, then the API verifies
# the Supabase access token and exchanges it for SkillMango httpOnly cookies.
# SUPABASE_PUBLISHABLE_KEY is safe to use here; SUPABASE_SERVICE_ROLE_KEY is
# optional, server-only, and must never be exposed to the browser or committed.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_JWT_ISSUER="" # Defaults to ${SUPABASE_URL}/auth/v1
SUPABASE_JWKS_URL="" # Defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE="authenticated"
SUPABASE_SERVICE_ROLE_KEY=""

# App / API server
# APP_URL is the API origin without /api/v1.
# FRONTEND_URL is used for CORS, cookies, password/reset links, and checkout redirects.
APP_PORT=4000
APP_ENV="development"
APP_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"

# Stripe payments
# Empty keys keep checkout in dev_pending mode and do not grant access.
# Local/test mode: use sk_test_* and the whsec_* value from `stripe listen`.
# Production: use live keys from Stripe Dashboard or your secret manager.
# Set STRIPE_WEBHOOK_SECRET before accepting webhook fulfillment.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# Razorpay payments
# Empty keys keep checkout in dev_pending mode and do not grant access.
# Local/test mode: use rzp_test_* dashboard keys and a test webhook secret.
# Production: use live Razorpay keys from your secret manager.
# Set RAZORPAY_WEBHOOK_SECRET before accepting webhook fulfillment.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# AI generation
# At least one generation provider key is required for production AI features.
# Missing keys return explicit provider configuration errors instead of silent fake completions.
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# Email (Resend)
# Empty key keeps development fallbacks/logging; production email delivery needs RESEND_API_KEY.
RESEND_API_KEY=""
EMAIL_FROM="noreply@skillmango.ai"

# S3-compatible storage
# Empty keys use local-dev upload policy responses only; production uploads need bucket + keys.
# For Amazon S3, leave S3_ENDPOINT empty and set S3_REGION to the bucket region.
# The Terraform stack in infra/aws-video-storage creates a least-privilege IAM user
# for creator-prefixed video uploads such as videos/creators/<creatorId>/file.mp4.
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET=""
S3_REGION=""

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
