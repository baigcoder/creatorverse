# SkillMango web environment variables
# Copy to apps/web/.env.local for local development.

# Browser-visible API base URL.
# Must include the API prefix `/api/v1`.
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# Browser-visible web app origin.
# Use your deployed frontend origin in production, for example:
# NEXT_PUBLIC_APP_URL="https://app.your-domain.com"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Auth
# These are browser-visible values. Use a Supabase publishable key, never a
# service_role/secret key. The API exchanges Supabase sessions for SkillMango
# httpOnly cookies after login.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
